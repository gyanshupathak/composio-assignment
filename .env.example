# AuthPath Environment Configuration
# Copy this file to .env.local and fill in what you need. Every setting is optional:
# without any keys, all guides open and the tests/evals run on recorded fixtures.

# 1. AI Model Provider (OpenAI-compatible Chat Completions endpoint)
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-5.5
AI_BASE_URL=https://api.openai.com/v1

# 2. Optional extra search engine. Not required: without it the agent uses OpenAI web search,
#    the public Stack Exchange API, the public GitHub Issues API and Composio's public docs.
TAVILY_API_KEY=your_tavily_api_key_here

# 3. Optional Composio API Key (For live GET https://backend.composio.dev/api/v3.1/toolkits/{slug} lookup)
COMPOSIO_API_KEY=your_composio_api_key_here

# 4. Where new guides and feedback are saved
#    file    = JSON files in data/ (default, good for running on your own computer)
#    upstash = an Upstash Redis database (use this when hosting; free hosts wipe local files)
AUTHPATH_STORAGE_PROVIDER=file
# Only needed when AUTHPATH_STORAGE_PROVIDER=upstash (copy both from the Upstash console, "REST API" section)
UPSTASH_REDIS_REST_URL=your_upstash_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# 5. Daily limit on new live researches (protects the AI budget on a public site).
#    Leave empty for no limit. Opening existing guides never counts.
LIVE_RESEARCH_DAILY_LIMIT=
